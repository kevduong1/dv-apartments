# Supabase — NOT required for local development.
# The app runs fully offline against local PGlite until you fill these in and
# wire a real sync engine (see lib/sync). Copy this file to .env.local then add:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Postgres connection string, used later by drizzle-kit to apply
# db/migrations to Supabase (drizzle-kit migrate / studio). Not used at runtime.
# DATABASE_URL=
